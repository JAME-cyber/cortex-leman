{
  "name": "cabinet-comptable-synthese",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 1 * *" }]
        }
      },
      "id": "1",
      "name": "Schedule Monthly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/operations-mensuelles",
        "method": "GET",
        "queryParameters": {
          "parameters": [
            { "name": "mois", "value": "={{new Date().getMonth() + 1}}" },
            { "name": "annee", "value": "={{new Date().getFullYear()}}" }
          ]
        }
      },
      "id": "2",
      "name": "Collecte Operations Mois",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [420, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "Tu es un expert-comptable. Génère une synthèse mensuelle professionnelle en français à partir des opérations suivantes.\n\nInclus:\n- Volume d'opérations par catégorie\n- Montants totaux (factures reçues, déclarations traitées, bilans préparés)\n- Points d'attention (échéances proches, anomalies)\n- Tendances vs mois précédent si possible\n\nDonnées: {{JSON.stringify($json.operations)}}",
        "temperature": 0.2,
        "maxTokens": 2000
      },
      "id": "3",
      "name": "LLM Synthese",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "fromEmail": "synthese@cabinet-comptable.ch",
        "toEmail": "comptable@cabinet-comptable.ch",
        "subject": "=Synthèse mensuelle - {{$json.mois}}/{{$json.annee}}",
        "text": "={{$json.synthese}}"
      },
      "id": "4",
      "name": "Email Rapport",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/archives/syntheses/{{new Date().toISOString().split('T')[0]}}-synthese.json",
        "content": "={{JSON.stringify($json)}}"
      },
      "id": "5",
      "name": "Archivage Synthese",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [1080, 300]
    }
  ],
  "connections": {
    "Schedule Monthly": {
      "main": [
        [{ "node": "Collecte Operations Mois", "type": "main", "index": 0 }]
      ]
    },
    "Collecte Operations Mois": {
      "main": [
        [{ "node": "LLM Synthese", "type": "main", "index": 0 }]
      ]
    },
    "LLM Synthese": {
      "main": [
        [{ "node": "Email Rapport", "type": "main", "index": 0 }]
      ]
    },
    "Email Rapport": {
      "main": [
        [{ "node": "Archivage Synthese", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "a1b2c3d4-0001-4000-8000-000000000003",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "cabinet-comptable"
  },
  "tags": [
    { "name": "cabinet-comptable" },
    { "name": "synthese-mensuelle" },
    { "name": "rapport" }
  ]
}
