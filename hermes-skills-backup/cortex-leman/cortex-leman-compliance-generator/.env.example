# Cortex Leman Compliance Generator - Environment Configuration

# OpenRouter API Key
# Obtenez votre clé sur: https://openrouter.ai/keys
# Modèle utilisé: DeepSeek v3.2 (deepseek/deepseek-chat-v3)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kie.ai API Key
# Clé fournie: [REDACTED-KIEAI-KEY]
KIEAI_API_KEY=[REDACTED-KIEAI-KEY]

# Configuration API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Configuration Génération
DEFAULT_PLATFORMS=linkedin,twitter
DEFAULT_IMAGE_COUNT=2
DEFAULT_TONE=professional
ENABLE_VALIDATION=true

# Configuration CORS
CORS_ORIGINS=*

# Configuration Timeout
GENERATION_TIMEOUT=300
IMAGE_TIMEOUT=120
POLL_INTERVAL=5
MAX_POLL_ATTEMPTS=24
