# Cortex Leman Compliance Generator - Frontend Environment Variables

# API URL
# URL de l'API backend (FastAPI)
# En développement: http://localhost:8000
# En production: https://api.cortex-leman.ch
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
NEXT_PUBLIC_APP_NAME=Cortex Leman Compliance Generator
NEXT_PUBLIC_APP_VERSION=1.0.0

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false

# Analytics (optionnel)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Theme
NEXT_PUBLIC_THEME=default
