{
  "vertical": "comptable",
  "description": "Règles de conformité pour cabinets comptables FR-CH",
  "risk_appetite": {
    "accept_max": 2,
    "arbitrate_threshold": 3,
    "block_threshold": 5,
    "comment": "Modéré: conformité fiscale importante mais plus de marge opérationnelle"
  },
  "rules": [
    {
      "id": "comptable-001",
      "name": "Aucune décision fiscale automatique",
      "severity": "critical",
      "condition": {
        "and": [
          {
            "==": [
              {
                "var": "action.type"
              },
              "decision_fiscale"
            ]
          },
          {
            "!": [
              {
                "var": "human_validated"
              }
            ]
          }
        ]
      },
      "action": "freeze",
      "message": "Art. 22 RGPD: Les décisions fiscales ne peuvent être entièrement automatisées. Validation humaine obligatoire."
    },
    {
      "id": "comptable-002",
      "name": "Données client en EU uniquement",
      "severity": "high",
      "condition": {
        "and": [
          {
            "==": [
              {
                "var": "action.type"
              },
              "data_transfer"
            ]
          },
          {
            "==": [
              {
                "var": "data_residency"
              },
              "CH"
            ]
          }
        ]
      },
      "action": "block",
      "message": "Les données comptables EU ne peuvent transiter par des serveurs CH sans accord préalable."
    },
    {
      "id": "comptable-003",
      "name": "Montant > 10K€ nécessite validation",
      "severity": "high",
      "condition": {
        "and": [
          {
            "!=": [
              {
                "var": "payload.montant"
              },
              null
            ]
          },
          {
            ">=": [
              {
                "var": "payload.montant"
              },
              10000
            ]
          }
        ]
      },
      "action": "arbitrate",
      "message": "Opération > 10 000€ détectée. Validation expert requise (anti-blanchiment)."
    },
    {
      "id": "comptable-004",
      "name": "Anti-biais: vérification cohérence",
      "severity": "medium",
      "condition": {
        "and": [
          {
            "!=": [
              {
                "var": "confidence_bias_score"
              },
              null
            ]
          },
          {
            ">=": [
              {
                "var": "confidence_bias_score"
              },
              0.7
            ]
          }
        ]
      },
      "action": "warn",
      "message": "Score de biais élevé détecté. Vérification manuelle recommandée."
    },
    {
      "id": "comptable-005",
      "name": "Audit trail obligatoire pour écritures",
      "severity": "critical",
      "condition": {
        "==": [
          {
            "var": "action.type"
          },
          "ecriture_comptable"
        ]
      },
      "action": "require_audit",
      "message": "Toute écriture comptable doit être tracée dans le journal d'audit."
    },
    {
      "id": "comptable-006",
      "name": "Déduction fiscale élevée",
      "severity": "high",
      "condition": {
        "and": [
          {
            "!=": [
              {
                "var": "payload.montant"
              },
              null
            ]
          },
          {
            ">=": [
              {
                "var": "payload.montant"
              },
              50000
            ]
          }
        ]
      },
      "action": "freeze",
      "message": "Déduction fiscale > 50 000 CHF détectée. Gel préventif: vérification du seuil de chiffre d'affaires et de l'éligibilité requise avant toute exécution."
    },
    {
      "id": "comptable-007",
      "name": "Conflit de déduction entre sources",
      "severity": "high",
      "condition": {
        "and": [
          {
            "!=": [
              {
                "var": "contradiction_count"
              },
              null
            ]
          },
          {
            ">": [
              {
                "var": "contradiction_count"
              },
              0
            ]
          }
        ]
      },
      "action": "freeze",
      "message": "Conflit détecté entre sources fiscales. Gel: arbitrage expert requis pour choisir la déduction applicable."
    },
    {
      "id": "comptable-008",
      "name": "Transfert données hors EU/CH",
      "severity": "high",
      "condition": {
        "and": [
          { "==": [{"var": "action.type"}, "data_transfer"] },
          { "!": [{"var": "hosting_in_eu_or_ch"}] }
        ]
      },
      "action": "arbitrate",
      "message": "RGPD Chap. V: Transfert de données hors UE/CH détecté. Garanties adequates requises (SCC, decision d'adequation, ou derogation)."
    },
    {
      "id": "comptable-009",
      "name": "Gouvernance IA — AI Act risque limite",
      "severity": "medium",
      "condition": {
        "and": [
          { "==": [{"var": "action.type"}, "llm_query"] },
          { "!": [{"var": "ai_act_registered"}] }
        ]
      },
      "action": "warn",
      "message": "AI Act Art. 52: Le systeme IA doit etre enregistre si profilage ou decision impactant les personnes."
    },
    {
      "id": "comptable-010",
      "name": "DPIA si traitement sensible",
      "severity": "high",
      "condition": {
        "and": [
          { "==": [{"var": "action.type"}, "data_transfer"] },
          { "==": [{"var": "data.transfer"}, "international"] },
          { "!": [{"var": "dpia_completed"}] }
        ]
      },
      "action": "arbitrate",
      "message": "RGPD Art. 35: AIPD/DPIA obligatoire avant tout transfert international de données comptables."
    },
    {
      "id": "comptable-011",
      "name": "Opération transfrontalière EU-CH",
      "severity": "medium",
      "condition": {
        "and": [
          { "==": [{"var": "action.type"}, "data_transfer"] },
          { "==": [{"var": "data_residency"}, "cross_border"] }
        ]
      },
      "action": "warn",
      "message": "Operations transfrontalieres EU-CH: verifier la conformite avec le RGPD et la nLPD suisse."
    },
    {
      "id": "comptable-012",
      "name": "Ecriture comptable sans pièce justificative",
      "severity": "high",
      "condition": {
        "and": [
          { "==": [{"var": "action.type"}, "ecriture_comptable"] },
          { "!": [{"var": "piece_justificative_presente"}] }
        ]
      },
      "action": "arbitrate",
      "message": "Normes DEC/OEC: Toute ecriture comptable doit etre accompagnee d'une piece justificative. Arbitrage expert."
    }
  ]
}